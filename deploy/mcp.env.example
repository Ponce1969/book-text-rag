# book-text-rag MCP — environment for book-text-rag-mcp.service
#
# Copy to /home/gonzalo/.config/book-text-rag/mcp.env and chmod 600.
# The token is a secret: never commit it, never paste it into a chat, never
# reuse the token of another MCP service (D-06 §5).
#
# Generate one with:   openssl rand -hex 32

# D-08 §OD-3: bind exclusively to the Tailscale interface. `0.0.0.0` and `::`
# are refused at startup on purpose: the service must never be reachable outside
# the tailnet.
BOOK_TEXT_RAG_MCP_BIND_ADDRESS=100.106.85.109
BOOK_TEXT_RAG_MCP_PORT=8020

# Opened read-only by the process; ingestion stays in the CLI (D-08 §OD-1).
BOOK_TEXT_RAG_MCP_STORE=/home/gonzalo/datos/book-text-rag/corpus.sqlite

# D-07: 5 s default, configurable.
BOOK_TEXT_RAG_MCP_QUERY_TIMEOUT_SECONDS=5

# Paste the output of `openssl rand -hex 32` here.
BOOK_TEXT_RAG_MCP_TOKEN=
